import React from 'react'

export default function SearchBar(){
  return (
    <div className="bg-white border border-gray-100 rounded-full shadow-md p-3 flex items-center gap-2">
      <div className="flex items-center gap-2 px-3">
        <svg className="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"></path></svg>
      </div>
      <input aria-label="Search" className="flex-1 px-4 py-3 text-base focus:ring-0 focus:outline-none" placeholder="Pretraži proizvode, gradove ili kategorije" />
      <select aria-label="Category" className="hidden sm:block text-sm border-l border-gray-100 px-4 py-3 bg-transparent">
        <option>Sve kategorije</option>
        <option>Vozila</option>
        <option>Nekretnine</option>
      </select>
      <select aria-label="Location" className="hidden md:block text-sm border-l border-gray-100 px-4 py-3 bg-transparent">
        <option>Svuda</option>
        <option>Zagreb</option>
      </select>
      <button className="ml-2 px-5 py-3 bg-primary text-white rounded-full shadow focus-ring">Traži</button>
    </div>
  )
}
