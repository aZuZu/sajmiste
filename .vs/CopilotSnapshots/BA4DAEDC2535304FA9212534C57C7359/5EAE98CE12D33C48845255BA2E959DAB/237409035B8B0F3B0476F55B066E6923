import React from 'react'
import { motion } from 'framer-motion'
import { useCategories } from '../hooks/useCategories'

function CategoryCard({ c }: { c: any }) {
  return (
    <motion.div
      whileHover={{ y: -4 }}
      className="bg-white rounded-xl border border-gray-100 p-3 flex items-center gap-4 hover:shadow-md transition-smooth cursor-pointer"
    >
      <div className="w-16 h-16 rounded-lg bg-gray-50 flex items-center justify-center text-3xl">
        {c.emoji}
      </div>
      <div>
        <div className="font-semibold text-lg">{c.name}</div>
        <div className="text-sm text-gray-500">{c.count} oglasa</div>
      </div>
    </motion.div>
  )
}

export default function Categories() {
  const { data: categories = [] } = useCategories()

  const containerVariants = {
    hidden: {},
    show: {
      transition: {
        staggerChildren: 0.06
      }
    }
  }

  const itemVariants = {
    hidden: { opacity: 0, y: 10 },
    show: { opacity: 1, y: 0 }
  }

  return (
    <section>
      <div className="flex items-center justify-between">
        <h2 className="text-3xl font-semibold">Popularne kategorije</h2>
        <a href="#" className="text-primary hover:text-secondary transition-smooth">
          Prikaži sve
        </a>
      </div>

      <motion.div
        initial="hidden"
        animate="show"
        variants={containerVariants}
        className="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4"
      >
        {categories.map(c => (
          <motion.div key={c.name} variants={itemVariants}>
            <CategoryCard c={c} />
          </motion.div>
        ))}
      </motion.div>
    </section>
  )
}
